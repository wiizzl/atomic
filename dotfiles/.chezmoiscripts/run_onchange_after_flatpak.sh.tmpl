#!/bin/bash
set -euo pipefail

command -v flatpak >/dev/null || exit 0

for repo in /etc/flatpak/remotes.d/*.flatpakrepo; do
  flatpak remote-add --user --if-not-exists "$(basename "$repo" .flatpakrepo)" "$repo"
done

flatpak install --user --noninteractive --or-update flathub \
{{- if get . "bitwarden_ssh" }}
  com.bitwarden.desktop \
{{- end }}
  com.usebruno.Bruno \
  org.localsend.localsend_app \
  dev.vencord.Vesktop

flatpak install --user --noninteractive --or-update flatpark \
  dev.dbflux.DBFlux \
  com.anthropic.ClaudeDesktop

flatpak override --user \
  --filesystem=xdg-config/gtk-3.0:ro \
  --filesystem=xdg-config/gtk-4.0:ro \
  --filesystem=xdg-data/icons:ro

flatpak override --user --filesystem=home dev.vencord.Vesktop
flatpak override --user --filesystem=home --socket=ssh-auth --talk-name=org.freedesktop.Flatpak --device=kvm \
  --talk-name=org.kde.StatusNotifierWatcher \
  --env=PATH={{ .chezmoi.homeDir }}/.local/share/flatpak-host/bin:/app/bin:/usr/bin \
  com.anthropic.ClaudeDesktop

"$HOME/.local/bin/flatpak-host-shims"
