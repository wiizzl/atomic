#!/bin/bash
set -euo pipefail

dir=$HOME/.local/share/flatpak-host/bin
host_cmds=(git podman docker mise)

mkdir -p "$dir"
find "$dir" -maxdepth 1 -type l -delete

for cmd in "${host_cmds[@]}"; do
  command -v "$cmd" >/dev/null && ln -s "$HOME/.local/bin/flatpak-host-exec" "$dir/$cmd"
done
for shim in "$HOME"/.local/share/mise/shims/*; do
  [[ -e $shim ]] && ln -sf "$HOME/.local/bin/flatpak-host-exec" "$dir/${shim##*/}"
done
