#!/bin/bash
set -euo pipefail

dir=$HOME/.local/share/flatpak-host/bin
host_cmds=(git podman docker mise)

mkdir -p "$dir"
find "$dir" -maxdepth 1 -type l -delete

for cmd in "${host_cmds[@]}"; do
  if command -v "$cmd" >/dev/null; then
    ln -s "$HOME/.local/bin/flatpak-host-exec" "$dir/$cmd"
  fi
done
for shim in "$HOME"/.local/share/mise/shims/*; do
  if [[ -e $shim ]]; then
    ln -sf "$HOME/.local/bin/flatpak-host-exec" "$dir/${shim##*/}"
  fi
done
