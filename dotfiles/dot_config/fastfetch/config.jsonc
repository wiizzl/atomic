{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.png",
    "width": 20,
  },
  "display": {
    "separator": "     ",
  },
  "modules": [
    {
      "type": "title",
      "format": "{#32}{1}{#90} @ {#34}{2}",
    },
    "break",
    {
      "type": "os",
      "key": "{#34}  os    ",
      "format": "{pretty-name}",
    },
    {
      "type": "kernel",
      "key": "{#36}  kernel",
    },
    {
      "type": "packages",
      "key": "{#31}󰏖  pkgs  ",
    },
    {
      "type": "wm",
      "key": "{#35}  wm    ",
      "format": "{pretty-name}",
    },
    {
      "type": "terminal",
      "key": "{#34}  term  ",
    },
    {
      "type": "shell",
      "key": "{#32}  shell ",
      "format": "{exe-name}",
    },
    {
      "type": "cpu",
      "key": "{#31}  cpu   ",
      "format": "{name}",
    },
    {
      "type": "memory",
      "key": "{#36}  memory",
    },
    {
      "type": "uptime",
      "key": "{#35}󰅐  uptime",
      "format": "{hours}h {minutes}m",
    },
    "break",
    {
      "type": "custom",
      "format": "{#33}󰮯  {#32}󰊠 {#31}󰊠 {#33}󰊠 {#35}󰊠 {#36}󰊠 {#90}󰊠 {#34}󰊠 {#93}󰊠 {#37}󰊠  ",
    },
  ],
}
