[bar.default]
thikness = 35
widget_spacing = 10
margin_ends = 0
panel_overlap = 2
position = "left"
radius = {{ .radius }}
radius_bottom_left = 0
radius_top_left = 0

start = ["notifications", "clock", "tray"]
center = ["workspaces"]
end = ["media", "volume", "bluetooth", "network", "battery", "session"]

[widget.workspaces]
change_color_on_hover = false
labels_only_when_occupied = true

[widget.media]
hide_when_no_media = true
title_scroll = "on_hover"

[widget.network]
show_label = false
vpn_status = "both"

[widget.volume]
show_label = false

[widget.battery]
show_label = false

[bar.default.dead_zone.actions]
right = "none"
