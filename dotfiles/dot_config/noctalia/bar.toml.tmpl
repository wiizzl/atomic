[bar.default]
thickness = 35
widget_spacing = 10
margin_ends = 0
panel_overlap = 2
position = "bottom"
radius = {{ .radius }}
radius_top_right = 0
radius_top_left = 0

start = ["notifications", "clock", "audio_visualizer", "notes_2", "bar"]
center = ["workspaces"]
end = ["tray", "volume", "bluetooth", "network", "battery", "session"]

[bar.default.dead_zone.actions]
right = "none"

[widget.timer]
type = "noctalia/timer:bar"
show_idle_on_horizontal = false

[widget.notes]
type = "noctalia/notes:notes"

[widget.workspaces]
change_color_on_hover = false
labels_only_when_occupied = true

[widget.network]
show_label = false
vpn_status = "both"

[widget.volume]
show_label = false

[widget.battery]
show_label = false

[widget.audio_visualizer]
interactive = false
show_when_idle = true
mirrored = false
bands = 25
color_1 = "on_surface"
color_2 = "on_surface"

[widget.tray]
drawer = true
hide_passive = false
