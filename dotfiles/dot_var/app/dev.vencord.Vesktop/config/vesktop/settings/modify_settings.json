{{- /* chezmoi:modify-template */ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $before := toJson $settings -}}
{{- $settings = setValueAtPath "frameless" true $settings -}}

{{- if gt .rounding 0 -}}
{{-   $settings = setValueAtPath "enabledThemes" (list "noctalia.theme.css") $settings -}}
{{- else -}}
{{-   $settings = setValueAtPath "enabledThemes" (list "discord-system24.css") $settings -}}
{{- end -}}

{{- if eq (toJson $settings) $before -}}
{{-   .chezmoi.stdin -}}
{{- else -}}
{{-   toPrettyJson "    " $settings -}}
{{- end -}}
